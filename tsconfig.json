{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",            
    
    "moduleResolution": "Bundler", 
    
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    

    "outDir": "./dist",
    
    "strict": true,
    "skipLibCheck": true,          
    
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "prisma.config.ts", "swagger.ts"],
  "exclude": ["node_modules"]
}