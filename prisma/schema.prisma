generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Proprietaire {
  id        Int      @id @default(autoincrement())
  nom       String
  prenom    String
  telephone String?
  email     String   @unique
  adresse   String?
  animaux   Animal[]
  
  @@map("proprietaire") 
}

model Animal {
  id             Int          @id @default(autoincrement())
  nom            String
  espece         String
  race           String?
  sexe           String?
  date_naissance DateTime?    @map("date_naissance")
  poids          Decimal?
  photo          String?
  proprietaireId Int          @map("proprietaire_id")
  proprietaire   Proprietaire @relation(fields: [proprietaireId], references: [id])
  visites        Visite[]

  @@map("animal")
}

model Veterinaire {
  id         Int      @id @default(autoincrement())
  nom        String
  prenom     String
  specialite String?
  telephone  String?
  email      String   @unique
  visites    Visite[]

  @@map("veterinaire")
}

model Visite {
  id            Int           @id @default(autoincrement())
  date_visite   DateTime      @default(now()) @map("date_visite")
  compte_rendu  String?       @map("compte_rendu")
  motif         String?
  
  animalId      Int           @map("animal_id")
  veterinaireId Int           @map("veterinaire_id")
  
  animal        Animal        @relation(fields: [animalId], references: [id])
  veterinaire   Veterinaire   @relation(fields: [veterinaireId], references: [id])
  vaccinations  EtreVaccine[]
  prescriptions Suivre[]

  @@map("visite")
}

model Vaccin {
  id                  Int           @id @default(autoincrement())
  type                String?
  nom                 String
  description         String?
  duree_validite_mois Int           @map("duree_validite_mois")
  vaccinations        EtreVaccine[]

  @@map("vaccin")
}

model EtreVaccine {
  id               Int       @id @default(autoincrement())
  date_vaccination DateTime  @default(now()) @map("date_vaccination")
  date_rappel      DateTime? @map("date_rappel")
  statut           String?   @default("EFFECTUE")
  lot              String?
  
  visiteId         Int       @map("visite_id")
  vaccinId         Int       @map("vaccin_id")
  
  visite           Visite    @relation(fields: [visiteId], references: [id])
  vaccin           Vaccin    @relation(fields: [vaccinId], references: [id])

  @@map("etre_vaccine")
}

model Traitement {
  id            Int      @id @default(autoincrement())
  nom           String
  dosage        String?
  frequence     String?
  prescriptions Suivre[]

  @@map("traitement")
}

model Suivre {
  id           Int        @id @default(autoincrement())
  date_debut   DateTime   @map("date_debut")
  date_fin     DateTime?  @map("date_fin")
  observation  String?
  
  visiteId     Int        @map("visite_id")
  traitementId Int        @map("traitement_id")
  
  visite       Visite     @relation(fields: [visiteId], references: [id])
  traitement   Traitement @relation(fields: [traitementId], references: [id])

  @@map("suivre")
}